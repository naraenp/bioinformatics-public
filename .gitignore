# ---------- Data-heavy and derived files ----------
# Large genomic/array formats are excluded by default; commit small reference
# tables explicitly via `git add -f path/to/file` when needed.
*.h5ad
*.h5
*.rds
*.tsv
*.csv
*.gz
*.zip
*.bam
*.bai
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.vcf
*.vcf.gz

# Small curated reference tables the analyses depend on: kept in the repo
# despite the blanket *.csv / *.tsv rules above (720 KB total).
!tcr_analysis/datasets/reference/*.csv
!tcr_analysis/datasets/reference/*.tsv

# ---------- Bioinformatics data directories ----------
data/raw/
datasets/raw/
tcr_analysis/datasets/experimental/samples/
# Parsed-once cache of the Adaptive exports (regenerated by TCR_analysis.ipynb)
tcr_analysis/cache/
# Per-run metric tables (the notebook prints the same summary inline)
tcr_analysis/results/
preleukemia_analysis/data/
preleukemia_analysis/figures/
preleukemia_analysis/preleuk_dashboard/plots/

